{
  "manifest_version": 3,
  "name": "Fuck the KLMS login",
  "version": "1.0",
  "permissions": ["cookies", "storage", "webNavigation"],
  "host_permissions": ["https://klms.kaist.ac.kr/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "web_accessible_resources": [
    {
      "resources": ["config.json"],
      "matches": ["https://klms.kaist.ac.kr/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "klms-login-addon@yourdomain.com",
      "strict_min_version": "109.0"
    }
  }
}
